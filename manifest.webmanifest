{
  "name": "홍콩·방콕 2026 · 우리의 여행",
  "short_name": "HK·BKK",
  "description": "가족의 홍콩·방콕 여행 일정",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f2ec",
  "theme_color": "#f6f2ec",
  "lang": "ko",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "오늘 일정", "url": "./#/day", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "숙소·항공", "url": "./#/stay", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "여행 도구", "url": "./#/tools", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
